  "query": "\n        SELECT id, created_at, updated_at, game_type_id, name, uri, is_public, is_deprecated\n        FROM game_versions\n        WHERE game_type_id = $1 AND is_deprecated = false\n        ORDER BY created_at DESC, name DESC\n        LIMIT 1\n        ",
